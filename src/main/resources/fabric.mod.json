{
	"schemaVersion": 1,
	"id": "integrationsoplenty",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": [
		"${mod_authors}"
	],
	"contact": {
		"homepage": "${mod_page_url}",
		"sources": "${mod_git_url}"
	},
	"license": "${mod_license}",
	"icon": "assets/integrationsoplenty/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.mariany.integrationsoplenty.IntegrationsOPlenty"
		],
		"fabric-datagen": [
			"dev.mariany.integrationsoplenty.IntegrationsOPlentyDataGenerator"
		]
	},
	"mixins": [
		"integrationsoplenty.mixins.json"
	],
	"accessWidener": "integrationsoplenty.accesswidener",
	"depends": {
		"fabricloader": ">=0.18.1",
		"minecraft": ">=1.21.11",
		"java": ">=21",
		"fabric-api": ">=0.138.3",
		"biomesoplenty": "*"
	}
}